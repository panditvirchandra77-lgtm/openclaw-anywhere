# Copy to .env and fill in. NEVER commit .env.
PREFIX=/workspace            # where everything is installed (must survive reboots/recycles)
TS_HOSTNAME=my-claw          # name of this machine on your tailnet
WEB_USER=admin               # login for the web terminal (ttyd)
WEB_PASS=change-me-now       # password for ttyd; first 8 chars are also the VNC password
ENABLE_DESKTOP=1             # 1 = also run browser desktop (noVNC), 0 = skip
# Optional: unattended tailscale login (tailnet admin -> Settings -> Keys -> auth key)
TS_AUTHKEY=
